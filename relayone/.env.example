PORT=6060
HOST=127.0.0.1
DATABASE_URL=postgresql://flydeck:change-me@127.0.0.1:5432/flydeck
DATABASE_SSL=false
RELAYONE_TITLE=Relay One
RELAYONE_INFO=Selected posts from my private Flydeck.
IMAGE_DIRECTORY=../flydon-server/images
RELAY_ASSET_DIRECTORY=../relayone-data/assets
# Set only on the independent Netcup backend. Minimum 32 characters.
# RELAY_INGEST_SECRET=replace-with-a-long-random-secret
RELAY_MAX_ASSET_BYTES=26214400
RELAY_DATA_SOURCE=legacy
PUBLIC_CACHE_SECONDS=30
