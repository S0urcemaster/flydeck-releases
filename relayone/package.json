{
  "name": "flydeck-relayone",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:server": "tsx watch src/server/server.ts",
    "build": "tsc -p tsconfig.client.json && tsc -p tsconfig.server.json && vite build",
    "migrate": "node dist-server/server/runMigrations.js",
    "start": "node dist-server/server/server.js",
    "test": "vitest run"
  },
  "dependencies": {
    "express": "^5.1.0",
    "pg": "^8.16.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/supertest": "^6.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "supertest": "^7.1.0",
    "tsx": "^4.20.0",
    "typescript": "^5.8.0",
    "vite": "^7.0.0",
    "vitest": "^4.1.0"
  }
}
