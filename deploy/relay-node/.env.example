RELAY_DB_PASSWORD=replace-with-a-long-random-database-password
RELAY_IMAGE_TAG=local
RELAY_HOST_PORT=6070

RELAY_NODE_ID=relay-two
RELAY_PUBLIC_ORIGIN=https://relay-two.relay-one.de
RELAY_TITLE=Relay Two
RELAY_INFO=Independent Relay reference node

RELAY_HOME_INGRESS_ENABLED=true
# These switches remain false until their server modules are implemented.
RELAY_FEDERATION_ENABLED=true
RELAY_ACCOUNTS_ENABLED=false
RELAY_DIAGNOSTICS_ENABLED=false

RELAY_INGEST_SECRET=replace-with-a-separate-long-random-ingest-secret
RELAY_MAX_ASSET_BYTES=26214400
PUBLIC_CACHE_SECONDS=15

# Hosted Flydeck. OAuth/Relay broker variables are intentionally absent.
FLYDECK_DB_PASSWORD=replace-with-a-long-random-flydeck-database-password
HOSTED_FLYDECK_DB_PASSWORD=replace-with-an-independent-hosted-database-password
FLYDECK_IMAGE_TAG=local
FLYDECK_HOST_PORT=6080
HOSTED_FLYDECK_HOST_PORT=6081
# Use true for both values behind the HTTPS reverse proxy on Netcup.
FLYDECK_SECURE_COOKIE=false
FLYDECK_TRUST_PROXY=false
