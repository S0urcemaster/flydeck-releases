NODE_ENV=production
PORT=6060
HOST=127.0.0.1
DATABASE_URL=postgresql://sntr@%2Fvar%2Frun%2Fpostgresql/relayone
DATABASE_SSL=false
RELAYONE_TITLE=Relay One
RELAYONE_INFO=
RELAY_DATA_SOURCE=projection
RELAY_ASSET_DIRECTORY=/var/lib/relayone/assets
RELAY_MAX_ASSET_BYTES=26214400
RELAY_INGEST_SECRET=replace-with-a-long-random-secret
PUBLIC_CACHE_SECONDS=15
FRONTEND_DIST=/opt/relayone/current/dist
# Optional Bluesky OAuth broker (enable all five together):
# OAUTH_BROKER_SECRET=replace-with-a-second-long-random-secret
# OAUTH_ENCRYPTION_KEY=replace-with-32-random-bytes-in-base64url
# OAUTH_CLIENT_PRIVATE_JWK=replace-with-a-private-jwk-encoded-as-base64url
# OAUTH_PUBLIC_ORIGIN=https://relay-one.de
# OAUTH_FLYDECK_RETURN_URL=https://flydon.tail4df832.ts.net/v2/
