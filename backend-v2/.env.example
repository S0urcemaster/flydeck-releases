PORT=5100
BASE_PATH=/flydeck
DATABASE_URL=postgresql://flydeck:change-me@127.0.0.1:5432/flydeck
BACKUP_DIRECTORY=backups
BACKUP_RETENTION=7
DATABASE_SSL=false
TRUST_PROXY=false
LOGIN_REQUIRED=false
