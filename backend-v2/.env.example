AUTH_SECURE_COOKIE=false
SESSION_TTL_DAYS=30
FRONTEND_BASE_PATH=/v2
# FRONTEND_DIST=/absolute/path/to/frontend-v2/dist
SCHEDULER_INTERVAL_MS=5000
