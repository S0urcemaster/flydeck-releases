FROM node:22-bookworm-slim AS build

WORKDIR /app
ARG FLYDECK_FRONTEND_BASE=/flydeck/
COPY package.json package-lock.json ./
COPY shared/package.json shared/package.json
COPY backend-v2/package.json backend-v2/package.json
COPY frontend-v2/package.json frontend-v2/package.json
COPY frontend/package.json frontend/package.json
COPY backend/package.json backend/package.json
COPY desktop-v2/package.json desktop-v2/package.json
COPY relayone/package.json relayone/package.json
RUN npm ci

COPY shared shared
COPY backend-v2 backend-v2
COPY frontend-v2 frontend-v2
COPY desktop-v2 desktop-v2
COPY relayone relayone
RUN npm run build -w shared \
 && npm run build -w backend-v2 \
 && npm run build -w frontend-v2 -- --base="$FLYDECK_FRONTEND_BASE" \
 && npm run build -w desktop-v2

FROM node:22-bookworm-slim

ENV NODE_ENV=production
WORKDIR /app
COPY --from=build /app/node_modules node_modules
COPY --from=build /app/package.json package.json
COPY --from=build /app/shared shared
COPY --from=build /app/backend-v2 backend-v2
COPY --from=build /app/frontend-v2/dist frontend-v2/dist
COPY --from=build /app/desktop-v2/dist desktop-v2/dist

EXPOSE 5100
CMD ["./node_modules/.bin/tsx", "backend-v2/src/server.ts"]
